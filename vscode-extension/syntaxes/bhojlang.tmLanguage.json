{
  "name": "BhojLang",
  "scopeName": "source.bhojlang",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#numbers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.bhojlang",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.bhojlang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.bhojlang",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.bhojlang",
          "match": "\\b(agar|warna|nahi|ant|dohrav|jabtak|kaam|laut)\\b"
        },
        {
          "name": "keyword.declaration.bhojlang",
          "match": "\\b(bata)\\b"
        },
        {
          "name": "support.function.bhojlang",
          "match": "\\b(likha)\\b"
        },
        {
          "name": "constant.language.bhojlang",
          "match": "\\b(sach|jhooth)\\b"
        },
        {
          "name": "keyword.operator.logical.bhojlang",
          "match": "\\b(aur|ya|na)\\b"
        },
        {
          "name": "entity.name.function.bhojlang",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.bhojlang",
          "match": "(==|!=|>=|<=|>|<|=|\\+|-|\\*|/)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.bhojlang",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    }
  }
}
