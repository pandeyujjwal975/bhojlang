{
  "name": "bhojlang-vscode",
  "displayName": "BhojLang",
  "description": "BhojLang language support for Visual Studio Code",
  "version": "0.1.0",
  "publisher": "pandeyujjwal975",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "bhojlang",
        "aliases": ["BhojLang", "bhoj"],
        "extensions": [".bhoj"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bhojlang",
        "scopeName": "source.bhojlang",
        "path": "./syntaxes/bhojlang.tmLanguage.json"
      }
    ]
  }
}
